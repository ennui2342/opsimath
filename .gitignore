# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep

# Ignore master key for decrypting credentials and more.
/config/master.key
/config/credentials/*.key

.byebug_history

# dotenv, dotenv-rails
/.env*

# node_modules (not expected to be needed — importmap/tailwindcss-rails are
# Node-free — but harmless to guard against if that ever changes)
/node_modules

# macOS
.DS_Store

# Claude Code session-local tooling state (e.g. scheduled-task locks) —
# not part of the project, shouldn't be committed.
/.claude/

# Real personal reading-history data used as local import/test fixtures —
# not tracked, even though this repo is private. See docs/INTEGRATIONS.md.
/import/

# Local dev database dumps (pg_dump snapshots) — real personal library
# data, same reasoning as /import/ above. Restore points for the dev DB,
# not part of the project itself.
/db/dumps/

# Python build/test artifacts (services/cover_compare/ — see its own
# README-equivalent, docs/INTEGRATIONS.md's Phase 3 addendum).
__pycache__/
*.pyc
.pytest_cache/
