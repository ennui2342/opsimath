# Local development image — distinct from the generated `Dockerfile`, which
# is production/Kamal-oriented (multi-stage, non-root, precompiled assets).
#
# Deliberately does NOT run `bundle install` here. An earlier version did,
# baking gems into the image at build time — which meant Gemfile.lock only
# ever existed inside that build layer, never on the host, requiring a
# manual `docker cp` after every gem change. Gems install at *container
# start* instead (see docker-compose.yml's `command:`), against the
# bind-mounted source where Gemfile.lock already lives — so it just
# updates on the host like any other file, automatically, the same way
# any other bind-mounted edit does. Gems themselves land in a named
# volume (BUNDLE_PATH below), not the bind-mounted source tree, so they
# don't bloat the host-visible project directory.
FROM ruby:4.0-slim

RUN apt-get update -qq && apt-get install --no-install-recommends -y \
      build-essential \
      git \
      libpq-dev \
      libvips \
      libyaml-dev \
      pkg-config \
      postgresql-client \
    && rm -rf /var/lib/apt/lists/*

ENV BUNDLE_PATH=/usr/local/bundle

WORKDIR /rails

EXPOSE 3000
