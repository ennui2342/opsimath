<div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
  <div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-900">
    <p class="mb-3 text-xs font-medium tracking-wide text-gray-500 uppercase dark:text-gray-400">Current</p>
    <div class="divide-y divide-gray-200 dark:divide-gray-700">
      <% @diffs.each do |diff| %>
        <div class="py-2">
          <p class="text-xs font-medium text-gray-500 dark:text-gray-400"><%= diff[:field].to_s.humanize %></p>
          <p class="text-sm text-gray-700 dark:text-gray-300"><%= diff[:current].presence || "(blank)" %></p>
        </div>
      <% end %>
    </div>
  </div>

  <div class="rounded-lg border border-conflict-800 bg-white p-4 dark:border-conflict-200 dark:bg-gray-900">
    <p class="mb-3 text-xs font-medium tracking-wide text-gray-500 uppercase dark:text-gray-400">Proposed</p>
    <div class="divide-y divide-gray-200 dark:divide-gray-700">
      <% @diffs.each do |diff| %>
        <label class="flex items-start gap-2 py-2">
          <%= check_box_tag "fields[]", diff[:field], true, id: "field_#{diff[:field]}", checked: true, class: "mt-1 h-4 w-4 rounded border-gray-300" %>
          <span class="flex-1">
            <span class="block text-xs font-medium text-gray-500 dark:text-gray-400"><%= diff[:field].to_s.humanize %></span>
            <span class="block text-sm font-semibold text-conflict-800 dark:text-conflict-200"><%= diff[:proposed] %></span>
            <%= render(Ui::BadgeComponent.new(text: diff[:source], variant: :default)) if diff[:source].present? %>
          </span>
        </label>
      <% end %>
    </div>
  </div>
</div>
