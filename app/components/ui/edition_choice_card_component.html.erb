<label class="flex cursor-pointer flex-col overflow-hidden rounded-lg border border-gray-200 has-[:checked]:border-green-600 has-[:checked]:ring-1 has-[:checked]:ring-green-600 dark:border-gray-800 dark:has-[:checked]:border-green-500 dark:has-[:checked]:ring-green-500">
  <div class="flex h-44 items-center justify-center bg-gray-50 p-2 dark:bg-gray-900">
    <% if card.cover_url %>
      <%= image_tag card.cover_url, alt: "Cover: #{headline}", loading: "lazy", class: "max-h-full max-w-full object-contain" %>
    <% else %>
      <span class="text-xs text-gray-400 dark:text-gray-500">No cover image</span>
    <% end %>
  </div>
  <div class="flex flex-1 flex-col gap-1 p-3 text-sm">
    <% if notes.any? %>
      <span class="flex flex-wrap gap-1"><% notes.each do |note| %><%= render Ui::BadgeComponent.new(text: note, variant: note == "Yours now" ? :success : :default) %><% end %></span>
    <% end %>
    <span class="flex items-start gap-2">
      <input type="radio" name="card" value="<%= token %>" required <%= "checked" if checked %>
             class="mt-0.5 h-4 w-4 text-green-600 focus:ring-2 focus:ring-green-600 dark:bg-gray-800">
      <span class="font-medium"><%= headline %></span>
    </span>
    <% if own_title %><span class="text-xs italic text-gray-600 dark:text-gray-400"><%= own_title %></span><% end %>
    <% if detail.present? %><span class="text-xs text-gray-500 dark:text-gray-400"><%= detail %></span><% end %>
    <span class="mt-auto text-xs text-gray-400 dark:text-gray-500"><%= [ card.isbns.first, sources ].compact.join(" · ") %></span>
  </div>
</label>
