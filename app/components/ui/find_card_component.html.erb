<article id="<%= dom_id(listing) %>" class="rounded-lg border border-gray-200 p-3 dark:border-gray-800">
  <div class="flex gap-3">
    <div class="flex flex-none gap-1">
      <% if listing.image_url %>
        <%= image_tag listing.image_url, alt: "eBay photo", loading: "lazy", class: "h-28 w-20 rounded object-cover" %>
      <% end %>
      <% if find.cover.cover_url %>
        <%= image_tag find.cover.cover_url, alt: "Matched cover", loading: "lazy", class: "h-28 w-20 rounded object-contain bg-gray-50 dark:bg-gray-900" %>
      <% end %>
    </div>
    <div class="min-w-0 flex-1 text-sm">
      <%= link_to find.item.title, helpers.wishlist_item_path(find.item), class: "block truncate font-medium hover:underline" %>
      <p class="truncate text-xs text-gray-500 dark:text-gray-400">
        <% if find.favourite? %><span title="Favourite artist" class="text-amber-500 dark:text-amber-400">★</span><% end %>
        <%= artist_line %> · <%= find.cover.summary %>
      </p>
      <p class="mt-1 font-medium"><%= price_line %></p>
      <p class="text-xs <%= find.reason == :target ? "text-green-700 dark:text-green-400" : "text-gray-600 dark:text-gray-400" %>"><%= reason_line %></p>
      <%= link_to listing.title, listing.link, target: "_blank", rel: "noopener",
                  class: "mt-1 block truncate text-xs text-gray-500 hover:underline dark:text-gray-400" %>
    </div>
  </div>
  <div class="mt-3 flex gap-3">
    <%= link_to "Open on eBay", listing.link, target: "_blank", rel: "noopener",
                class: "rounded-md bg-green-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-green-700 dark:bg-green-700 dark:hover:bg-green-600" %>
    <%= button_to "Dismiss", helpers.dismiss_ebay_listing_path(listing), method: :post,
                  class: "rounded-md bg-gray-200 px-3 py-1.5 text-sm font-medium text-gray-800 hover:bg-gray-300 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600" %>
    <%= link_to "Wrong printing", helpers.edit_ebay_listing_path(listing),
                class: "ml-auto self-center text-sm text-gray-500 hover:underline dark:text-gray-400" %>
  </div>
</article>
