<% if row? %>
<div class="flex gap-3 px-4 py-3" data-card="edition">
  <%= link_to work_url || "#", class: "flex-none", tabindex: -1 do %>
    <% if (variant = cover_variant) %>
      <%= image_tag variant, class: "h-16 w-11 rounded object-cover", alt: "", loading: "lazy" %>
    <% else %>
      <span class="flex h-16 w-11 items-center justify-center rounded border border-dashed border-gray-300 text-center text-[9px] leading-tight text-gray-400 dark:border-gray-600 dark:text-gray-500">No cover</span>
    <% end %>
  <% end %>
  <div class="flex min-w-0 flex-1 flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
    <div class="flex min-w-0 items-baseline gap-3">
      <% if @number.present? %><span data-card-number class="w-10 flex-none text-right text-xs tabular-nums text-gray-400 dark:text-gray-500"><%= @number %></span><% end %>
      <div class="min-w-0">
        <%= link_to title, work_url || "#", class: "block font-medium text-gray-900 hover:underline dark:text-gray-100", data: { card_title: true } %>
        <% if (by = author_line) %><p class="text-xs text-gray-600 dark:text-gray-300"><%= by %></p><% end %>
        <p class="text-xs text-gray-500 dark:text-gray-400"><%= [ short_headline, detail_line ].uniq.join(" · ") %></p>
      </div>
    </div>
    <% if status_badges.any? %>
      <div class="flex flex-none flex-wrap gap-1 <%= "pl-[3.25rem] sm:pl-0" if @number.present? %>">
        <% status_badges.each do |text, variant| %><%= render(Ui::BadgeComponent.new(text:, variant:)) %><% end %>
      </div>
    <% end %>
  </div>
</div>
<% elsif !full? %>
<div class="text-xs" data-card="edition">
  <%= link_to work_url || "#", class: "group block" do %>
    <div class="relative flex aspect-[2/3] items-center justify-center overflow-hidden rounded border border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-900">
      <% if (variant = cover_variant) %>
        <%= image_tag variant, alt: "", loading: "lazy", class: "h-full w-full object-cover" %>
      <% else %>
        <span class="px-1 text-center text-gray-400">No cover</span>
      <% end %>
      <% if @number.present? %><span data-card-number class="absolute left-1 top-1 rounded bg-black/70 px-1.5 py-0.5 text-[10px] font-semibold text-white"><%= @number %></span><% end %>
    </div>
    <span class="mt-1 block truncate font-medium text-gray-900 group-hover:underline dark:text-gray-100" data-card-title><%= title %></span>
  <% end %>
  <% if (by = author_line) %><span class="block truncate text-gray-600 dark:text-gray-300"><%= by %></span><% end %>
  <span class="block truncate text-gray-500 dark:text-gray-400"><%= short_headline %></span>
  <% if status_badges.any? %>
    <span class="mt-0.5 flex flex-wrap gap-1"><% status_badges.each do |text, variant| %><%= render(Ui::BadgeComponent.new(text:, variant:)) %><% end %></span>
  <% end %>
</div>
<% else %>
<div class="relative flex gap-4 rounded-lg border border-gray-200 p-4 dark:border-gray-700">
  <div class="relative flex-none" data-controller="cover-picker">
    <% cover_action = cover_choices.any? ? { action: "contextmenu->cover-picker#open" } : {} %>
    <% if (variant = cover_variant) %>
      <%= image_tag variant, class: "h-32 w-auto rounded object-cover", alt: "", data: cover_action %>
    <% else %>
      <div class="flex h-32 w-[5.5rem] items-center justify-center rounded border border-dashed border-gray-300 text-center text-xs text-gray-400 dark:border-gray-600 dark:text-gray-500"
           data-action="<%= cover_action[:action] %>">
        No cover
      </div>
    <% end %>

    <% if cover_choices.any? %>
      <%# Rolls out from the cover in place — not a centered <dialog>: no
          top-layer/backdrop, positioned relative to the cover itself, and
          the "closed" scale/opacity classes below are the transition's
          start state, toggled by cover_picker_controller.js. %>
      <div data-cover-picker-target="panel" hidden
           class="absolute left-0 top-0 z-20 w-max origin-top-left rounded-lg border border-gray-200 bg-white p-3 shadow-lg transition duration-150 ease-out dark:border-gray-700 dark:bg-gray-900">
        <p class="mb-2 text-[10px] font-semibold tracking-wide text-gray-400 uppercase dark:text-gray-500">Choose a cover</p>
        <div class="flex gap-2">
          <% cover_choices.each do |record| %>
            <%= button_to edition_metadata_path(@edition), method: :patch,
                  params: { field_picks: [ "#{record.provider}:cover_image" ] },
                  class: "block rounded border-2 border-transparent p-0 hover:border-conflict-800 dark:hover:border-conflict-200" do %>
              <%= image_tag record.cover_image.variant(resize_to_limit: [ 160, 240 ]), class: "rounded", alt: record.provider %>
              <span class="mt-1 block text-center text-[10px] text-gray-500 dark:text-gray-400"><%= record.provider.humanize %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="flex min-w-0 flex-1 flex-col gap-1">
    <p class="font-medium text-gray-900 dark:text-gray-100"><%= headline_html %></p>

    <% if status_badges.any? %>
      <div class="flex flex-wrap items-center gap-1.5">
        <% status_badges.each do |text, variant| %>
          <%= render(Ui::BadgeComponent.new(text: text, variant: variant)) %>
        <% end %>
      </div>
    <% end %>

    <% if detail_line.present? %>
      <p class="text-sm text-gray-500 dark:text-gray-400"><%= @publisher_url && artist ? helpers.safe_join([ format_line, " · ", helpers.artist_links(artist) ]) : detail_line %></p>
    <% end %>

    <% if isbn_identifiers.any? || link_identifiers.any? %>
      <div class="mt-1 space-y-1 font-mono text-xs text-gray-500 dark:text-gray-400">
        <% [ isbn_identifiers, link_identifiers ].each do |row| %>
          <% next if row.empty? %>
          <div class="flex flex-wrap gap-x-3 gap-y-1">
            <% row.each do |label, value, url| %>
              <span>
                <b class="font-semibold text-gray-400 dark:text-gray-500"><%= label %></b>
                <% if url %>
                  <%= link_to value, url, target: "_blank", rel: "noopener", class: "underline hover:text-gray-700 dark:hover:text-gray-200" %>
                <% else %>
                  <%= value %>
                <% end %>
              </span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= link_to edition_metadata_path(@edition),
        class: "absolute bottom-2 right-2 text-gray-300 hover:text-gray-600 dark:text-gray-600 dark:hover:text-gray-300",
        "aria-label": "Reconcile this edition's metadata", title: "Reconcile metadata" do %>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
      <path fill-rule="evenodd" d="M11.078 2.25c-.917 0-1.699.663-1.85 1.567L9.05 4.889c-.02.12-.115.26-.297.348a7.493 7.493 0 0 0-.986.57c-.166.115-.334.126-.45.083L6.3 5.508a1.875 1.875 0 0 0-2.282.819l-.922 1.597a1.875 1.875 0 0 0 .432 2.385l.84.692c.095.078.17.229.154.43a7.598 7.598 0 0 0 0 1.139c.015.2-.059.352-.153.43l-.841.692a1.875 1.875 0 0 0-.432 2.385l.922 1.597a1.875 1.875 0 0 0 2.282.818l1.019-.382c.115-.043.283-.031.45.082.312.214.641.405.985.57.182.088.277.228.297.35l.178 1.071c.151.904.933 1.567 1.85 1.567h1.844c.916 0 1.699-.663 1.85-1.567l.178-1.072c.02-.12.114-.26.297-.349.344-.165.673-.356.985-.57.167-.114.335-.125.45-.082l1.02.382a1.875 1.875 0 0 0 2.28-.819l.923-1.597a1.875 1.875 0 0 0-.432-2.385l-.84-.692c-.095-.078-.17-.229-.154-.43a7.614 7.614 0 0 0 0-1.139c-.016-.2.059-.352.153-.43l.84-.692c.708-.582.891-1.59.433-2.385l-.923-1.597a1.875 1.875 0 0 0-2.28-.818l-1.02.382c-.115.043-.283.031-.45-.082a7.49 7.49 0 0 0-.985-.57c-.183-.088-.277-.228-.297-.35l-.179-1.072a1.875 1.875 0 0 0-1.85-1.567h-1.843ZM12 15.75a3.75 3.75 0 1 0 0-7.5 3.75 3.75 0 0 0 0 7.5Z" clip-rule="evenodd" />
    </svg>
  <% end %>
</div>
<% end %>
