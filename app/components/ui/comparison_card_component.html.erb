<% ring = "border-conflict-800 ring-1 ring-conflict-800 dark:border-conflict-200 dark:ring-conflict-200" %>
<% outer = @card.proposed ? ring : "border-gray-200 dark:border-gray-700" %>
<% outer += " has-[:checked]:border-conflict-800 has-[:checked]:ring-1 has-[:checked]:ring-conflict-800 dark:has-[:checked]:border-conflict-200 dark:has-[:checked]:ring-conflict-200" if @card.select_name %>
<div class="flex flex-col overflow-hidden rounded-lg border bg-white dark:bg-gray-900 <%= outer %>">
  <% header = "flex items-center justify-between gap-2 border-b px-4 py-3 " + (@card.proposed ? "border-conflict-800 bg-conflict-100 dark:border-conflict-200 dark:bg-conflict-900" : "border-gray-200 dark:border-gray-700") %>
  <%= content_tag(@card.select_name ? :label : :div, class: header + (@card.select_name ? " cursor-pointer" : "")) do %>
    <span class="flex items-center gap-2">
      <% if @card.select_name %>
        <%= radio_button_tag @card.select_name, @card.select_value, @card.selected, id: "#{@card.input_scope}select_#{@card.select_value}", class: "h-4 w-4 flex-shrink-0 border-gray-300" %>
      <% end %>
      <span class="text-xs font-bold tracking-wide uppercase <%= @card.proposed ? "text-conflict-800 dark:text-conflict-200" : "text-gray-500 dark:text-gray-400" %>">
        <%= @card.label %>
      </span>
    </span>
    <% if @card.meta %>
      <span class="text-xs whitespace-nowrap text-gray-400 dark:text-gray-500"><%= @card.meta.to_date.iso8601 %></span>
    <% end %>
  <% end %>

  <% if cover_present? %>
    <div class="flex flex-col items-center gap-2 px-4 pt-4">
      <%= image_tag cover_thumb,
            class: "rounded shadow #{"ring-2 ring-conflict-800 dark:ring-conflict-200" if @card.cover_selectable}", alt: "" %>
      <%= render(Ui::BadgeComponent.new(text: @card.cover_chip, variant: :default)) if @card.cover_chip.present? %>
      <% if @card.cover_selectable %>
        <label class="flex items-center gap-1.5 text-xs font-semibold text-conflict-800 dark:text-conflict-200">
          <%= check_box_tag checkbox_name, checkbox_value("cover_image"), field_checked, id: field_id("cover_image"), disabled: @card.fields_disabled,
                class: "h-4 w-4 rounded border-gray-300", data: { field_pick_target: "box", action: "change->field-pick#pick" } %>
          Apply this cover
        </label>
      <% end %>
    </div>
  <% elsif @card.cover_url.present? %>
    <div class="flex justify-center px-4 pt-4">
      <%= image_tag @card.cover_url, class: "h-40 w-auto rounded shadow", alt: "", loading: "lazy" %>
    </div>
  <% elsif @card.show_empty_cover %>
    <div class="flex justify-center px-4 pt-4">
      <div class="flex h-40 w-28 items-center justify-center rounded border border-dashed border-gray-300 text-center text-xs text-gray-400 dark:border-gray-600 dark:text-gray-500">
        No cover
      </div>
    </div>
  <% end %>

  <div class="flex flex-1 flex-col gap-2 px-4 py-3">
    <% @card.fields.each do |row| %>
      <div class="flex items-start gap-2 <%= "-mx-2 rounded-md border border-conflict-800 bg-conflict-100 px-2 py-1.5 dark:border-conflict-200 dark:bg-conflict-900" if row.selectable %>">
        <% if row.selectable %>
          <%= check_box_tag checkbox_name, checkbox_value(row.name), field_checked, id: field_id(row.name), disabled: @card.fields_disabled,
                class: "mt-0.5 h-4 w-4 flex-shrink-0 rounded border-gray-300", data: { field_pick_target: "box", action: "change->field-pick#pick" } %>
        <% end %>
        <div class="min-w-0 flex-1">
          <span class="block text-[10px] font-semibold tracking-wide text-gray-400 uppercase dark:text-gray-500"><%= row.name.to_s.humanize %></span>
          <span class="block text-sm <%= row.selectable ? "font-semibold text-conflict-800 dark:text-conflict-200" : "text-gray-700 dark:text-gray-300" %>">
            <% if row.value.blank? %>
              <span class="text-gray-400 italic dark:text-gray-500">(blank)</span>
            <% else %>
              <%= row.value %>
            <% end %>
            <%= render(Ui::BadgeComponent.new(text: row.chip, variant: :default)) if row.chip.present? %>
          </span>
        </div>
        <% if (a = row.authority) %>
          <%# not a nested <form> — the whole review screen is already one; the controller POSTs via fetch %>
          <div class="relative shrink-0" data-controller="authority-panel"
               data-authority-panel-url-value="<%= helpers.settings_authority_terms_path(a[:vocabulary]) %>"
               data-authority-panel-preview-url-value="<%= helpers.settings_authority_terms_preview_path(a[:vocabulary]) %>"
               data-authority-panel-decision-value="<%= a[:decision_id] %>"
               data-authority-panel-current-value="<%= a[:current] %>"
               data-authority-panel-proposed-value="<%= a[:proposed] %>">
            <button type="button" data-action="authority-panel#toggle" title="Same publisher — establish an authority term"
                    class="rounded border border-conflict-800/40 px-1.5 text-sm leading-tight text-conflict-800 hover:bg-conflict-200 dark:border-conflict-200/40 dark:text-conflict-200 dark:hover:bg-conflict-800">&#8801;</button>
            <div data-authority-panel-target="panel" hidden
                 class="absolute right-0 z-20 mt-1 w-72 rounded-md border border-gray-200 bg-white p-3 text-left shadow-lg dark:border-gray-700 dark:bg-gray-900">
              <p class="mb-2 text-xs font-semibold text-gray-700 dark:text-gray-200">Same publisher? Establish an authority term.</p>
              <div class="space-y-1.5 text-xs text-gray-700 dark:text-gray-300">
                <label class="flex items-start gap-1.5">
                  <input type="radio" name="preferred" value="<%= a[:current] %>" checked class="mt-0.5" data-authority-panel-target="choice" data-action="change->authority-panel#refreshPreview">
                  <span>prefer <b><%= a[:current] %></b> <span class="text-gray-400">(on file)</span></span>
                </label>
                <label class="flex items-start gap-1.5">
                  <input type="radio" name="preferred" value="<%= a[:proposed] %>" class="mt-0.5" data-authority-panel-target="choice" data-action="change->authority-panel#refreshPreview">
                  <span>prefer <b><%= a[:proposed] %></b> <span class="text-gray-400">(<%= a[:source] %>)</span></span>
                </label>
                <label class="flex items-center gap-1.5">
                  <input type="radio" name="preferred" value="__other__" class="mt-0.5" data-authority-panel-target="choice otherRadio" data-action="change->authority-panel#refreshPreview">
                  <input type="text" placeholder="other…" data-authority-panel-target="otherInput" data-action="focus->authority-panel#pickOther input->authority-panel#refreshPreview"
                         class="w-full rounded border-gray-300 px-1.5 py-0.5 dark:border-gray-600 dark:bg-gray-800">
                </label>
              </div>
              <p data-authority-panel-target="preview" class="mt-2 text-[11px] leading-snug text-gray-500 dark:text-gray-400"></p>
              <button type="button" data-action="authority-panel#submit"
                      class="mt-2.5 w-full rounded bg-green-600 px-2 py-1 text-xs font-medium text-white hover:bg-green-700 dark:bg-green-700 dark:hover:bg-green-600">Establish term</button>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @card.identifiers.present? %>
    <div class="flex flex-wrap gap-x-3 gap-y-1 border-t border-dashed border-gray-200 px-4 py-3 font-mono text-xs text-gray-500 dark:border-gray-700 dark:text-gray-400">
      <% @card.identifiers.each do |label, value| %>
        <span><b class="font-semibold text-gray-400 dark:text-gray-500"><%= label %></b> <%= value %></span>
      <% end %>
    </div>
  <% end %>

  <% if @card.info_note.present? %>
    <p class="px-4 pb-3 text-xs text-gray-400 dark:text-gray-500"><%= @card.info_note %></p>
  <% end %>
</div>
