<% content_for :title, @name %>

<div class="w-full max-w-3xl">
  <p class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Publisher</p>
  <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100"><%= @name %></h1>
  <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
    <%= pluralize(@editions.size, "edition") %> in your catalogue
    <% if @spellings.size > 1 %>· as <%= @spellings.map { |s, n| "#{s} (#{n})" }.join(", ") %><% end %>
  </p>
  <% if @lines.any? %>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
      Lines:
      <%= safe_join(@lines.map { |id, name, _| link_to(name, line_path(id), class: "text-gray-800 hover:underline dark:text-gray-200") }, " · ") %>
    </p>
  <% end %>

  <div class="mt-6 divide-y divide-gray-200 rounded-lg border border-gray-200 dark:divide-gray-700 dark:border-gray-700 <%= "hidden" if @editions.empty? %>">
    <% @editions.each do |edition| %>
      <%= render Ui::EditionCardComponent.new(edition:, size: :row, number: edition.publish_date.to_s[0, 4]) %>
    <% end %>
  </div>

  <%= link_to "Back to books", works_path, class: "mt-8 inline-block text-sm text-gray-500 hover:underline dark:text-gray-400" %>
</div>
