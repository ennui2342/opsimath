<% content_for :title, @work.title %>
<% badge = ApplicationHelper::WORK_STATUS_BADGES %>
<% primary = "rounded-md bg-green-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-green-700 dark:bg-green-700 dark:hover:bg-green-600" %>
<% secondary = "rounded-md bg-gray-200 px-3 py-1.5 text-sm font-medium text-gray-800 hover:bg-gray-300 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600" %>
<% open_reading = @work.readings.find(&:open?) %>

<div class="w-full max-w-3xl">
  <div class="mb-1 flex flex-wrap items-center gap-2">
    <%= render(Ui::BadgeComponent.new(text: @work.literary_form)) %>
    <% @work.statuses.each do |s| %><%= render(Ui::BadgeComponent.new(text: badge[s].first, variant: badge[s].last)) %><% end %>
  </div>
  <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100"><%= @work.title %></h1>
  <% if @work.subtitle.present? %>
    <p class="text-lg text-gray-600 dark:text-gray-400"><%= @work.subtitle %></p>
  <% end %>

  <p class="mt-1 text-gray-700 dark:text-gray-300">
    <%= safe_join(@work.work_contributors.sort_by { |wc| wc.display_order || Float::INFINITY }.map do |wc|
          link = link_to(wc.contributor.name, author_path(wc.contributor), class: "hover:underline")
          wc.role == "author" ? link : safe_join([ link, " (#{wc.role})" ])
        end, ", ") %>
  </p>

  <% if @work.work_series.any? %>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
      <% @work.work_series.each do |ws| %>
        <%= link_to ws.series.name, series_path(ws.series), class: "hover:underline" %><%= " ##{format('%g', ws.position)}" if ws.position %><%= ", " unless ws == @work.work_series.last %>
      <% end %>
    </p>
  <% end %>

  <div class="mt-3 flex flex-wrap gap-2">
    <% @work.genres.each { |g| %><%= render(Ui::BadgeComponent.new(text: g.name)) %><% } %>
    <% @work.subjects.each { |s| %><%= render(Ui::BadgeComponent.new(text: s.name)) %><% } %>
    <% @work.tags.each { |t| %><%= render(Ui::BadgeComponent.new(text: t.name)) %><% } %>
  </div>

  <% if @work.description.present? %>
    <p class="mt-4 text-gray-700 dark:text-gray-300"><%= @work.description %></p>
  <% end %>

  <%# Wishlist: the catalogue side. Bargain hunting has its own page. %>
  <div class="mt-4 flex flex-wrap items-center gap-3 text-sm">
    <% if @work.want %>
      <span class="text-gray-600 dark:text-gray-400">On your wishlist.</span>
      <%= link_to "Bargain hunting", wishlist_item_path(@work.want), class: "text-green-700 hover:underline dark:text-green-400" %>
      <%= button_to "Remove from wishlist", work_want_path(@work), method: :delete, class: secondary,
                    form: { data: { turbo_confirm: @work.editions.empty? ? "Remove “#{@work.title}” from your wishlist? It isn't otherwise in your catalogue, so it goes completely." : "Remove “#{@work.title}” from your wishlist?" } } %>
    <% else %>
      <%= button_to "Add to wishlist", work_want_path(@work), method: :post, class: secondary %>
    <% end %>
  </div>

  <%= render "reading", work: @work, open_reading:, primary:, secondary: %>

  <% if @work.editions.any? %>
    <h2 class="mt-8 mb-3 text-xl font-semibold text-gray-900 dark:text-gray-100">Editions</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <% @work.editions_in_order.each do |edition| %>
        <div>
          <%= render(Ui::EditionCardComponent.new(edition:, publisher_url: (publisher_path(name: edition.publisher) if edition.publisher.present?))) %>
          <% pub_id = edition.edition_identifiers.find { |i| i.id_type == "isfdb" }&.value %>
          <% line = pub_id && @work.provider_editions.find { |p| p.provider == "isfdb" && p.provider_id == pub_id && p.pub_series_id } %>
          <% if line %>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
              In <%= link_to line.pub_series_name.presence || "ISFDB line #{line.pub_series_id}", line_path(line.pub_series_id), class: "text-gray-700 hover:underline dark:text-gray-300" %><%= " ##{line.pub_series_num}" if line.pub_series_num.present? %>
            </p>
          <% end %>
          <% Array(@decisions[edition.id]).each do |decision| %>
            <p class="mt-2 rounded-md border border-conflict-200 bg-conflict-100 px-3 py-2 text-sm text-conflict-800 dark:border-conflict-900 dark:bg-conflict-900 dark:text-conflict-200">
              <% if decision.kind == "enrichment_printing_choice" %>
                Several printings share this ISBN.
                <%= link_to "Which is yours?", edit_work_edition_change_path(@work, edition), class: "font-medium underline" %>
              <% elsif decision.payload["identity_question"] %>
                <%= decision_summary(decision) %>
                <%= link_to "Which is yours?", edit_work_edition_change_path(@work, edition), class: "font-medium underline" %>
              <% else %>
                <%= decision_summary(decision) %>
                <%= link_to "Review", pending_decision_path(decision, work_id: @work.id), class: "font-medium underline" %>
              <% end %>
            </p>
          <% end %>
          <%= render "edition_panel", work: @work, edition:, secondary: %>
        </div>
      <% end %>
    </div>
  <% elsif @work.want %>
    <p class="mt-8 text-sm text-gray-500 dark:text-gray-400">
      No edition in your catalogue yet — a wanted book.
      <%= link_to "I've got it — choose the edition", add_book_editions_path(work_id: @work.id), class: "ml-1 text-green-700 hover:underline dark:text-green-400" %>
    </p>
  <% end %>
  <% if @work.editions.any? %>
    <p class="mt-2 text-sm"><%= link_to "Add another edition", add_book_editions_path(work_id: @work.id), class: "text-gray-500 hover:underline dark:text-gray-400" %></p>
  <% end %>

  <%= render "reading_history", work: @work, primary:, secondary: %>

  <% if @work.reviews.any? %>
    <h2 class="mt-8 mb-3 text-xl font-semibold text-gray-900 dark:text-gray-100">Reviews</h2>
    <% @work.reviews.each do |review| %>
      <div class="mb-4 rounded-lg border border-gray-200 p-4 dark:border-gray-700">
        <p class="text-sm text-gray-500 dark:text-gray-400">
          <%= review.published_at || review.created_at.to_date %> &middot; <%= review.rating ? "#{review.rating.to_i}★" : "unrated" %>
          <% if review.draft? %> &middot; draft<% end %>
        </p>
        <div class="mt-2 text-gray-700 dark:text-gray-300">
          <%= render(Ui::MarkdownComponent.new(text: review.text)) %>
        </div>
      </div>
    <% end %>
  <% end %>

  <%= link_to "Back to books", works_path, class: "mt-8 inline-block text-sm text-gray-500 hover:underline dark:text-gray-400" %>
</div>
