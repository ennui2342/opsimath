<%# Under each edition card: what it is to Mark (EditionHolding), choosing
    the right printing, and deleting it if it was a mistake (EditionRemoval).
    No "copies" in the interface — that's the table behind the status. %>
<% field = "rounded-md border border-gray-300 px-2 py-1 text-sm focus:ring-2 focus:ring-green-600 dark:border-gray-700 dark:bg-gray-900" %>
<% label = "mb-1 block text-xs font-medium uppercase text-gray-500 dark:text-gray-400" %>
<% status = EditionHolding.status(edition) %>
<% copy = EditionHolding.copy(edition) %>
<% others = work.editions_in_order.reject { |e| e == edition } %>

<details class="mt-2 text-sm">
  <summary class="cursor-pointer text-gray-500 hover:underline dark:text-gray-400">
    <%= [ EditionHolding::STATUSES.fetch(status), ("bought #{copy.acquired_date.to_fs(:long)}" if copy&.acquired_date), copy&.acquired_source.presence ].compact.join(" · ") %>
    — change
  </summary>

  <%= form_with url: holding_work_edition_path(work, edition), method: :patch, class: "mt-2 grid grid-cols-2 gap-2" do %>
    <label class="col-span-2"><span class="<%= label %>">This edition is</span>
      <select name="status" class="<%= field %>">
        <% EditionHolding::STATUSES.each do |value, text| %>
          <option value="<%= value %>" <%= "selected" if value == status %>><%= value == "not_mine" ? "Not mine — read from a library or borrowed" : text %></option>
        <% end %>
      </select></label>
    <label><span class="<%= label %>">Acquired</span><input type="date" name="details[acquired_date]" value="<%= copy&.acquired_date %>" class="w-full <%= field %>"></label>
    <label><span class="<%= label %>">Price (£)</span><input type="number" step="0.01" min="0" name="details[acquired_price]" value="<%= copy&.acquired_price %>" class="w-full <%= field %>"></label>
    <label><span class="<%= label %>">From</span><input type="text" name="details[acquired_source]" value="<%= copy&.acquired_source %>" placeholder="eBay, a shop…" class="w-full <%= field %>"></label>
    <label><span class="<%= label %>">Condition</span><input type="text" name="details[condition]" value="<%= copy&.condition %>" class="w-full <%= field %>"></label>
    <label class="col-span-2"><span class="<%= label %>">Notes</span><input type="text" name="details[notes]" value="<%= copy&.notes %>" class="w-full <%= field %>"></label>
    <div class="col-span-2"><button type="submit" class="<%= secondary %>">Save</button></div>
  <% end %>

  <p class="mt-3"><%= link_to "Not this printing? Choose the right one", edit_work_edition_change_path(work, edition), class: "text-gray-500 hover:underline dark:text-gray-400" %></p>

  <% if others.any? %>
    <%= form_with url: work_edition_path(work, edition), method: :delete, class: "mt-4 flex flex-wrap items-end gap-2 border-t border-gray-200 pt-3 dark:border-gray-800",
                  data: { turbo_confirm: "Delete this #{[ edition.publisher, edition.publish_date&.slice(0, 4) ].compact.join(' ')} edition? It's for a duplicate or a mistake — if you sold or gave it away, change its status instead." } do %>
      <% if edition.readings.any? %>
        <label><span class="<%= label %>">Its <%= pluralize(edition.readings.size, "reading") %></span>
          <select name="move_to" class="<%= field %>">
            <% others.each do |other| %>
              <option value="<%= other.id %>">Move to <%= [ other.publisher || "edition ##{other.id}", other.publish_date&.slice(0, 4) ].compact.join(" ") %><%= " (#{EditionHolding::STATUSES.fetch(EditionHolding.status(other)).downcase})" %></option>
            <% end %>
            <option value="delete">Delete them too</option>
          </select></label>
      <% end %>
      <button type="submit" class="text-sm text-gray-500 hover:text-conflict-800 hover:underline dark:text-gray-400 dark:hover:text-conflict-200">Delete this edition — added by mistake</button>
    <% end %>
  <% end %>
</details>
