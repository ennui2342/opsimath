<% content_for :title, "Books" %>

<div class="w-full max-w-3xl">
  <h1 class="mb-4 text-2xl font-bold text-gray-900 dark:text-gray-100">Books</h1>

  <ul class="divide-y divide-gray-200 rounded-lg border border-gray-200 dark:divide-gray-700 dark:border-gray-700">
    <% @works.each do |work| %>
      <li>
        <%= link_to work_path(work), class: "flex items-center justify-between gap-4 px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-800" do %>
          <span class="font-medium text-gray-900 dark:text-gray-100"><%= work.title %></span>
          <span class="text-sm text-gray-500 dark:text-gray-400">
            <%= work.work_contributors.where(role: "author").map { |wc| wc.contributor.name }.join(", ") %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
