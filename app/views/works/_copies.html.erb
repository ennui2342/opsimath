<%# Copies of one edition: what became of each, and record another. %>
<% field = "rounded-md border border-gray-300 px-2 py-1 text-sm focus:ring-2 focus:ring-green-600 dark:border-gray-700 dark:bg-gray-900" %>
<% label = "mb-1 block text-xs font-medium uppercase text-gray-500 dark:text-gray-400" %>

<details class="mt-2 text-sm">
  <summary class="cursor-pointer text-gray-500 hover:underline dark:text-gray-400">
    Copies (<%= edition.copies.size %>)
  </summary>
  <ul class="mt-2 space-y-2">
    <% edition.copies.sort_by(&:id).each do |copy| %>
      <li>
        <%= form_with model: [ work, copy ], method: :patch, class: "flex flex-wrap items-center gap-2" do |f| %>
          <span class="text-gray-600 dark:text-gray-400">
            <%= [ copy.acquired_date, copy.condition, copy.acquired_source ].compact_blank.join(" · ").presence || "Copy" %>
          </span>
          <%= f.select :disposition, Copy::DISPOSITION_LABELS.invert, {}, class: field, "aria-label": "What became of this copy" %>
          <%= f.submit "Update", class: secondary %>
        <% end %>
      </li>
    <% end %>
  </ul>
  <%= form_with model: [ work, Copy.new ], class: "mt-3 grid grid-cols-2 gap-2" do |f| %>
    <%= f.hidden_field :edition_id, value: edition.id %>
    <label><span class="<%= label %>">Acquired</span><%= f.date_field :acquired_date, value: Date.current, class: "w-full #{field}" %></label>
    <label><span class="<%= label %>">Price (£)</span><%= f.number_field :acquired_price, step: "0.01", min: 0, class: "w-full #{field}" %></label>
    <label><span class="<%= label %>">From</span><%= f.text_field :acquired_source, placeholder: "eBay, a shop…", class: "w-full #{field}" %></label>
    <label><span class="<%= label %>">Condition</span><%= f.text_field :condition, class: "w-full #{field}" %></label>
    <label class="col-span-2"><span class="<%= label %>">Notes</span><%= f.text_field :notes, class: "w-full #{field}" %></label>
    <div class="col-span-2"><%= f.submit "Add a copy", class: primary %></div>
  <% end %>
</details>
