<%# Copies of one edition: what became of each, and record another. %>
<% field = "rounded-md border border-gray-300 px-2 py-1 text-sm focus:ring-2 focus:ring-green-600 dark:border-gray-700 dark:bg-gray-900" %>
<% label = "mb-1 block text-xs font-medium uppercase text-gray-500 dark:text-gray-400" %>

<details class="mt-2 text-sm">
  <% by_disposition = edition.copies.group_by(&:disposition).map { |d, cs| "#{cs.size} #{Copy::DISPOSITION_LABELS[d].downcase}" } %>
  <summary class="cursor-pointer text-gray-500 hover:underline dark:text-gray-400">
    <%= edition.copies.any? ? "Your #{'copy'.pluralize(edition.copies.size)}: #{by_disposition.to_sentence}" : "No copy — add one" %>
  </summary>
  <ul class="mt-2 space-y-2">
    <% edition.copies.sort_by(&:id).each do |copy| %>
      <li>
        <%= form_with model: [ work, copy ], method: :patch, class: "flex flex-wrap items-end gap-2" do |f| %>
          <span class="w-full text-gray-600 dark:text-gray-400">
            <%= [ ("acquired #{copy.acquired_date.to_fs(:long)}" if copy.acquired_date), copy.condition, copy.acquired_source ].compact_blank.join(" · ").presence || "Your copy" %>
          </span>
          <label><span class="<%= label %>">What became of it</span>
            <%= f.select :disposition, Copy::DISPOSITION_LABELS.invert, {}, class: field %></label>
          <%= f.submit "Save", class: secondary %>
        <% end %>
        <%= button_to "Delete — added by mistake", work_copy_path(work, copy), method: :delete,
                      class: "mt-1 text-xs text-gray-500 hover:text-conflict-800 hover:underline dark:text-gray-400 dark:hover:text-conflict-200",
                      form: { data: { turbo_confirm: edition.copies.size == 1 && edition.readings.empty? ? "Delete this copy? Its edition goes too, as nothing else uses it. (Sold or gave it away? Use “What became of it” instead.)" : "Delete this copy? (Sold or gave it away? Use “What became of it” instead.)" } } %>
      </li>
    <% end %>
  </ul>
  <% if edition.copies.any? %>
    <p class="mt-4 border-t border-gray-200 pt-3 text-xs font-medium uppercase text-gray-500 dark:border-gray-800 dark:text-gray-400">Add another copy</p>
  <% end %>
  <%= form_with model: [ work, Copy.new ], class: "mt-3 grid grid-cols-2 gap-2" do |f| %>
    <%= f.hidden_field :edition_id, value: edition.id %>
    <label><span class="<%= label %>">Acquired</span><%= f.date_field :acquired_date, value: Date.current, class: "w-full #{field}" %></label>
    <label><span class="<%= label %>">Price (£)</span><%= f.number_field :acquired_price, step: "0.01", min: 0, class: "w-full #{field}" %></label>
    <label><span class="<%= label %>">From</span><%= f.text_field :acquired_source, placeholder: "eBay, a shop…", class: "w-full #{field}" %></label>
    <label><span class="<%= label %>">Condition</span><%= f.text_field :condition, class: "w-full #{field}" %></label>
    <label class="col-span-2"><span class="<%= label %>">Notes</span><%= f.text_field :notes, class: "w-full #{field}" %></label>
    <div class="col-span-2"><%= f.submit "Add a copy", class: primary %></div>
  <% end %>
</details>
