<%# Every read, newest first — each correctable, or deletable with a confirmation. %>
<% field = "rounded-md border border-gray-300 px-2 py-1 text-sm focus:ring-2 focus:ring-green-600 dark:border-gray-700 dark:bg-gray-900" %>
<% label = "mb-1 block text-xs font-medium uppercase text-gray-500 dark:text-gray-400" %>
<% variant = ->(r) { r.completed? ? :info : (r.open? ? :accent : :default) } %>
<% statuses = { "reading" => "Reading", "paused" => "Paused", "completed" => "Read", "dnf" => "Did not finish" } %>
<% readings = work.readings.sort_by { |r| [ r.date_started || r.date_finished || Date.new(1), r.id ] }.reverse %>

<% if readings.any? %>
  <h2 class="mt-8 mb-3 text-xl font-semibold text-gray-900 dark:text-gray-100">Reading history</h2>
  <ul class="divide-y divide-gray-200 rounded-lg border border-gray-200 dark:divide-gray-700 dark:border-gray-700">
    <% readings.each do |reading| %>
      <li class="px-4 py-3 text-sm">
        <details>
          <summary class="flex cursor-pointer items-center justify-between gap-3">
            <span>
              <%= render(Ui::BadgeComponent.new(text: statuses.fetch(reading.status, reading.status), variant: variant.(reading))) %>
              <%= reading.date_started %> &ndash; <%= reading.date_finished %>
            </span>
            <span class="text-gray-500 dark:text-gray-400"><%= reading.rating ? "#{reading.rating.to_i}★" : nil %></span>
          </summary>
          <%= form_with model: [ work, reading ], method: :patch, class: "mt-3 flex flex-wrap items-end gap-2" do |f| %>
            <label><span class="<%= label %>">Status</span><%= f.select :status, statuses.invert, {}, class: field %></label>
            <label><span class="<%= label %>">Started</span><%= f.date_field :date_started, class: field %></label>
            <label><span class="<%= label %>">Finished</span><%= f.date_field :date_finished, class: field %></label>
            <label><span class="<%= label %>">Rating</span><%= f.select :rating, [ [ "–", "" ] ] + (1..5).map { |n| [ "#{n}★", n ] }, { selected: reading.rating&.to_i }, class: field %></label>
            <label class="w-full"><span class="<%= label %>">Private notes</span><%= f.text_field :private_notes, class: "w-full #{field}" %></label>
            <%= f.submit "Save", class: primary %>
          <% end %>
          <%= button_to "Delete this reading", work_reading_path(work, reading), method: :delete,
                        class: "mt-2 text-sm text-gray-500 hover:underline dark:text-gray-400",
                        form: { data: { turbo_confirm: "Delete this reading (#{statuses.fetch(reading.status, reading.status).downcase}#{", #{reading.date_finished}" if reading.date_finished})?" } } %>
        </details>
      </li>
    <% end %>
  </ul>
<% end %>
