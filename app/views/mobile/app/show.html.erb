<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#1f2937">
  <title>opsimath · pocket</title>
  <link rel="manifest" href="<%= mobile_manifest_path %>">
  <link rel="apple-touch-icon" href="/icon-180.png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="<%= asset_path("pocket.css") %>">
</head>
<body>
  <header>
    <h1>pocket</h1>
    <p id="status" class="status">starting…</p>
  </header>

  <form id="search" autocomplete="off">
    <input id="q" type="search" enterkeyhint="search" placeholder="title, author, or ISBN" autofocus>
    <button id="scan" type="button" hidden>scan</button>
  </form>

  <main id="results"></main>
  <p id="empty" class="empty" hidden>no match in your collection or wishlist</p>

  <div id="scanner" hidden>
    <video id="cam" playsinline muted></video>
    <div class="reticle"></div>
    <p id="scanhint">point at the barcode</p>
    <p id="scansub">older paperbacks carry a shop UPC, not an ISBN — close and type the number instead</p>
    <button id="scanclose" type="button" aria-label="close scanner">✕</button>
  </div>

  <script>window.__pocket = <%= @config.to_json.html_safe %>;</script>
  <script src="<%= asset_path("sqljs.js") %>"></script>
  <script src="<%= asset_path("pocket.js") %>"></script>
</body>
</html>
