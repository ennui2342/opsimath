<%
  # The shell page itself is NOT precached here — fetching it during
  # install would rotate the ApiToken out from under the page that just
  # loaded. The fetch handler caches it on the first real navigation.
  shell = [
    mobile_manifest_path,
    asset_path("pocket.css"),
    asset_path("pocket.js"),
    asset_path("sqljs.js"),
    asset_path("sqljs.wasm"),
    asset_path("zxing_reader.js"),
    asset_path("zxing_reader.wasm"),
    asset_path("scan.js"),
    "/icon.png"
  ]
  cache_name = "pocket-#{Digest::SHA1.hexdigest(shell.join)[0, 12]}"
%>
const CACHE = <%= cache_name.to_json.html_safe %>;
const SHELL = <%= shell.to_json.html_safe %>;

self.addEventListener("install", (event) => {
  event.waitUntil(caches.open(CACHE).then((cache) => cache.addAll(SHELL)).then(() => self.skipWaiting()));
});

const SHELL_PAGE = <%= mobile_app_path.to_json.html_safe %>;

// Older versions' caches go only once this version has its own shell
// page: until then the old shell (and the assets it names, still in its
// cache) is what opens the app offline. Deleting them first left nothing
// to open when the warm-up below failed — a deploy while the phone
// couldn't reach the server (Mark, 2026-11-19).
const dropOldCaches = () =>
  caches.keys().then((keys) => Promise.all(keys.filter((k) => k.startsWith("pocket-") && k !== CACHE).map((k) => caches.delete(k))));

self.addEventListener("activate", (event) => {
  event.waitUntil(
    self.clients.claim()
      // Warm the shell so a fresh install can open offline. Safe: /mobile
      // only issues a new token when there isn't one to reuse.
      .then(() => caches.open(CACHE))
      .then((c) => c.add(SHELL_PAGE).then(dropOldCaches))
      .catch(() => {})
  );
});

// The shell page cached by this version, else by an older one still kept.
const cachedShell = () =>
  caches.open(CACHE).then((c) => c.match(SHELL_PAGE)).then((hit) => hit || caches.match(SHELL_PAGE));

// The network, given up after a few seconds: a phone with signal but no
// route to the server would otherwise wait out the browser's own timeout.
const NETWORK_WAIT_MS = 4000;
const fetchQuickly = (request) =>
  new Promise((resolve, reject) => {
    const timer = setTimeout(() => reject(new Error("network too slow")), NETWORK_WAIT_MS);
    fetch(request).then((res) => { clearTimeout(timer); resolve(res); }, (err) => { clearTimeout(timer); reject(err); });
  });

self.addEventListener("fetch", (event) => {
  const url = new URL(event.request.url);
  if (event.request.method !== "GET" || url.origin !== self.location.origin) return;

  // The snapshot + version check and the service worker itself are never
  // cached here — the app manages the snapshot in IndexedDB, and a stale
  // SW would defeat updates.
  if (url.pathname.startsWith("/mobile/snapshot") || url.pathname === <%= mobile_service_worker_path.to_json.html_safe %>) return;

  // Shell page: fresh when the server answers within a few seconds, else
  // the cached one.
  if (url.pathname === SHELL_PAGE || url.pathname === SHELL_PAGE + "/") {
    event.respondWith(
      fetchQuickly(event.request)
        .then((res) => {
          if (!res.ok) return cachedShell().then((hit) => hit || res);
          const copy = res.clone();
          event.waitUntil(caches.open(CACHE).then((c) => c.put(SHELL_PAGE, copy)).then(dropOldCaches));
          return res;
        })
        .catch(() => cachedShell().then((hit) => hit || Response.error()))
    );
    return;
  }

  // Everything else in scope: cache-first, falling back to the network.
  event.respondWith(caches.match(event.request).then((hit) => hit || fetch(event.request)));
});
