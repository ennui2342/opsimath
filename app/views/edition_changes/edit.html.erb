<% content_for :title, "Which edition is this?" %>

<div class="w-full max-w-5xl">
  <h1 class="text-2xl font-bold">Which edition is this?</h1>
  <p class="text-sm text-gray-500 dark:text-gray-400">
    <%= @work.title %> — on file as <%= [ @edition.publisher, @edition.publish_date&.slice(0, 4) ].compact.join(" ").presence || "an unidentified edition" %><%= ", ISBN #{@isbn}" if @isbn %>
    <% if @hidden.positive? %>
      · <%= link_to "#{@hidden} other-language #{'edition'.pluralize(@hidden)} hidden", edit_work_edition_change_path(@work, @edition, all_languages: 1), class: "hover:underline" %>
    <% end %>
  </p>
  <p class="mb-4 mt-1 text-sm text-gray-600 dark:text-gray-400">
    <% if @choice_pending %>
      More than one printing carries this ISBN — choose the one you have.
    <% else %>
      Choosing another makes this edition that printing: its details, cover and identifiers are replaced; your copies and readings stay.
    <% end %>
  </p>

  <% if @cards.empty? %>
    <p class="text-sm text-gray-600 dark:text-gray-400">Neither ISFDB nor Open Library lists editions for this book yet.</p>
  <% else %>
    <%= form_with url: work_edition_change_path(@work, @edition), method: :patch do %>
      <%= render "add_books/edition_grid", cards: @cards, title: @work.title, notes: method(:notes_for) %>
      <button type="submit" class="mb-6 rounded-md bg-green-600 px-4 py-2 font-medium text-white hover:bg-green-700 dark:bg-green-700 dark:hover:bg-green-600">This is my edition</button>
    <% end %>
  <% end %>

  <%= link_to "Back", work_path(@work), class: "text-sm text-gray-500 hover:underline dark:text-gray-400" %>

  <%# Out of the way: removing the edition altogether (EditionRemoval). %>
  <% if @other_editions.any? %>
    <section class="mt-12 border-t border-gray-200 pt-6 dark:border-gray-800">
      <h2 class="mb-1 text-sm font-semibold uppercase text-gray-500 dark:text-gray-400">Remove this edition</h2>
      <% if @shared.any? %>
        <p class="text-sm text-gray-600 dark:text-gray-400">It's also an edition of <%= @shared.map(&:title).to_sentence %>, so it can't be removed from here.</p>
      <% else %>
        <% copies, readings = @edition.copies.size, @edition.readings.size %>
        <% label = [ ("#{pluralize(copies, 'copy')}" if copies.positive?), ("#{pluralize(readings, 'reading')}" if readings.positive?) ].compact.to_sentence %>
        <p class="mb-3 text-sm text-gray-600 dark:text-gray-400">For a duplicate, or an edition added by mistake. Reviews stay with the book.</p>
        <%= form_with url: work_edition_change_path(@work, @edition), method: :delete, class: "flex flex-wrap items-end gap-3",
                      data: { turbo_confirm: "Remove this #{[ @edition.publisher, @edition.publish_date&.slice(0, 4) ].compact.join(' ')} edition?" } do %>
          <% if label.present? %>
            <label class="text-sm">
              <span class="mb-1 block text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Its <%= label %></span>
              <select name="move_to" class="rounded-md border border-gray-300 px-2 py-1.5 text-sm focus:ring-2 focus:ring-green-600 dark:border-gray-700 dark:bg-gray-900">
                <% @other_editions.each do |other| %>
                  <% has = [ (pluralize(other.copies.size, "copy") if other.copies.any?), (pluralize(other.readings.size, "reading") if other.readings.any?) ].compact %>
                  <option value="<%= other.id %>">Move to <%= [ other.publisher || "edition ##{other.id}", other.publish_date&.slice(0, 4) ].compact.join(" ") %><%= " (has #{has.to_sentence})" if has.any? %></option>
                <% end %>
                <option value="delete">Delete them too</option>
              </select>
            </label>
          <% end %>
          <button type="submit" class="rounded-md border border-conflict-200 bg-conflict-100 px-3 py-1.5 text-sm font-medium text-conflict-800 hover:bg-conflict-200 dark:border-conflict-900 dark:bg-conflict-900 dark:text-conflict-200">Remove edition</button>
        <% end %>
      <% end %>
    </section>
  <% end %>
</div>
