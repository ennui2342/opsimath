<% content_for :title, "Edition reconciliations" %>

<div class="w-full max-w-3xl">
  <h1 class="mb-1 text-2xl font-bold text-gray-900 dark:text-gray-100">Edition reconciliations</h1>
  <p class="mb-6 text-sm text-gray-500 dark:text-gray-400">
    A Goodreads shelf event matched a book you own, but not a specific edition.
  </p>

  <% if @reconciliations.any? %>
    <ul class="divide-y divide-gray-200 rounded-lg border border-gray-200 dark:divide-gray-700 dark:border-gray-700">
      <% @reconciliations.each do |rec| %>
        <li>
          <%= link_to edition_reconciliation_path(rec),
                class: "flex items-center justify-between gap-4 px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-800" do %>
            <span class="font-medium text-gray-900 dark:text-gray-100"><%= rec.work.title %></span>
            <%= render(Ui::BadgeComponent.new(text: rec.shelf, variant: :conflict)) %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <%= render "all_done" %>
  <% end %>
</div>
