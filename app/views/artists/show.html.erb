<% content_for :title, @name %>
<% owned = @editions.count { |e| EditionHolding.status(e) == "owned" } %>

<div class="w-full max-w-5xl">
  <p class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Cover artist</p>
  <h1 class="flex items-center gap-2 text-3xl font-bold text-gray-900 dark:text-gray-100">
    <%= button_to artist_favourite_path, params: { name: @name, on: (@favourite ? "0" : "1"), all: (1 if @all_formats) },
                  form: { class: "inline" }, title: (@favourite ? "A favourite artist — click to unstar" : "Star as a favourite artist"),
                  "aria-label": (@favourite ? "Unstar #{@name}" : "Star #{@name}"),
                  class: "leading-none #{@favourite ? "text-amber-500 hover:text-amber-600 dark:text-amber-400" : "text-gray-300 hover:text-amber-500 dark:text-gray-600"}" do %>★<% end %>
    <%= @name %>
  </h1>
  <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
    <%= pluralize(@editions.size, "cover") %> in your catalogue · <%= owned %> owned<%= " · a favourite artist" if @favourite %>
    · <%= link_to "Collecting settings", settings_collecting_profile_path, class: "hover:underline" %>
  </p>
  <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
    <% if @all_formats %>
      Showing every physical printing's cover, your settings aside.
      <%= link_to "Show just your collecting rule's covers", artist_path(name: @name), class: "text-green-700 hover:underline dark:text-green-400" %>
    <% else %>
      Showing the covers your collecting rule offers, as bargain hunting does.
      <%= link_to "Show all formats", artist_path(name: @name, all: 1), class: "text-green-700 hover:underline dark:text-green-400" %>
    <% end %>
  </p>

  <h2 class="mb-3 mt-6 text-sm font-semibold uppercase text-gray-500 dark:text-gray-400">Your covers</h2>
  <% if @editions.empty? %>
    <p class="text-sm text-gray-500 dark:text-gray-400">None in your catalogue yet.</p>
  <% else %>
    <div class="grid grid-cols-3 gap-3 sm:grid-cols-4 lg:grid-cols-6">
      <% @editions.each do |edition| %>
        <%= render Ui::EditionCardComponent.new(edition:, size: :tile) %>
      <% end %>
    </div>
  <% end %>

  <% if @wishlist.any? %>
    <h2 class="mb-3 mt-8 text-sm font-semibold uppercase text-gray-500 dark:text-gray-400">Their covers on your wishlist</h2>
    <div class="grid grid-cols-3 gap-3 sm:grid-cols-4 lg:grid-cols-6">
      <% @wishlist.each do |want, printings| %>
        <% printing = printings.find { |p| p.cover_url.present? } || printings.first %>
        <%= render Ui::BookCandidateCardComponent.new(size: :tile, title: want.title, authors: want.work.authors.map(&:name), dim: false,
                                                      cover_url: printing.cover_url.presence, url: work_path(want.work),
                                                      detail: printings.map { |p| [ p.publisher.to_s.split(" / ").first, p.year ].compact.join(" ") }.uniq.first(2).join(", ")) %>
      <% end %>
    </div>
  <% end %>

  <% if @elsewhere.any? %>
    <h2 class="mb-1 mt-8 text-sm font-semibold uppercase text-gray-500 dark:text-gray-400">Their covers on books you have</h2>
    <p class="mb-3 text-xs text-gray-500 dark:text-gray-400">Other printings of books in your catalogue — not the one you have, not being hunted.</p>
    <div class="grid grid-cols-3 gap-3 sm:grid-cols-4 lg:grid-cols-6">
      <% @elsewhere.each do |printings| %>
        <% p = printings.find { |x| x.cover_url.present? } || printings.first %>
        <%= render Ui::BookCandidateCardComponent.new(size: :tile, title: p.work.title, authors: p.work.authors.map(&:name),
                                                      cover_url: p.cover_url.presence, url: work_path(p.work),
                                                      detail: printings.map { |x| [ x.publisher.to_s.split(" / ").first, x.year ].compact.join(" ") }.uniq.first(2).join(", ")) do %>
          <%= button_to "Want this cover", artist_want_cover_path, params: { work_id: p.work_id, name: @name, pub_ids: printings.map(&:provider_id), all: (1 if @all_formats) },
                        class: card_button_class %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%= link_to "Back to books", works_path, class: "mt-8 inline-block text-sm text-gray-500 hover:underline dark:text-gray-400" %>
</div>
