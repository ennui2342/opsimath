<%# What a dismissed find's card becomes: one line, with an undo. %>
<div id="<%= dom_id(listing) %>" class="flex items-center gap-3 rounded-lg border border-dashed border-gray-300 px-3 py-2 text-sm text-gray-500 dark:border-gray-700 dark:text-gray-400">
  <span class="min-w-0 flex-1 truncate">Dismissed “<%= listing.title %>”</span>
  <%= button_to "Undo", restore_ebay_listing_path(listing), method: :post, class: "text-sm font-medium text-green-700 hover:underline dark:text-green-400" %>
</div>
