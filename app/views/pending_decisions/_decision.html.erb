<div id="pending_decision" class="w-full max-w-5xl" data-controller="decision-shortcuts">
  <% if pending_decision %>
    <% case pending_decision.kind %>
    <% when "reread_conflict" %>
      <%= render "decision_reread_conflict", pending_decision: pending_decision, kind_filter: kind_filter %>
    <% when "enrichment_printing_choice" %>
      <%= render "decision_printing_choice", pending_decision: pending_decision, kind_filter: kind_filter %>
    <% else %>
      <%= render "decision_comparison", pending_decision: pending_decision, kind_filter: kind_filter %>
    <% end %>
  <% else %>
    <%= render "pending_decisions/all_done", kind_filter: kind_filter %>
  <% end %>
</div>
