<% entity = pending_decision.entity %>

<div class="mb-4">
  <%= render(Ui::BadgeComponent.new(text: pending_decision.kind, variant: :conflict)) %>
</div>

<% if entity.is_a?(Edition) %>
  <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
    <%= entity.works.map(&:title).join(", ").presence || "Edition ##{entity.id}" %>
  </h1>
  <p class="mb-4 text-sm text-gray-500 dark:text-gray-400">
    <%= entity.works.flat_map { |w| w.work_contributors.where(role: "author").map { |wc| wc.contributor.name } }.uniq.join(", ").presence || "Unknown author" %>
  </p>
<% else %>
  <h1 class="mb-4 text-2xl font-bold text-gray-900 dark:text-gray-100">Unknown entity</h1>
<% end %>

<% cards = pending_decision.comparison_cards %>

<%= form_with url: accept_pending_decision_path(pending_decision, kind: kind_filter), method: :post,
      data: { turbo_stream: true, decision_shortcuts_target: "accept" } do %>
  <% if cards %>
    <div class="mb-6 grid grid-cols-1 items-start gap-4 lg:grid-cols-3">
      <%= render(Ui::ComparisonCardComponent.new(card: cards[:edition])) %>
      <% cards[:others].each do |card| %>
        <%= render(Ui::ComparisonCardComponent.new(card: card)) %>
      <% end %>
      <%= render(Ui::ComparisonCardComponent.new(card: cards[:proposed])) %>
    </div>
  <% else %>
    <p class="mb-6 py-3 text-sm text-gray-500 dark:text-gray-400">
      No automatic action known for this kind yet — accept/reject only marks it reviewed.
    </p>
  <% end %>

  <button type="submit" class="rounded-md bg-green-600 px-4 py-2 font-medium text-white hover:bg-green-700 dark:bg-green-700 dark:hover:bg-green-600">
    Accept (A)
  </button>
<% end %>

<div class="mt-3 flex gap-3">
  <%= button_to "Reject (R)", reject_pending_decision_path(pending_decision, kind: kind_filter),
        method: :post, form: { data: { turbo_stream: true, decision_shortcuts_target: "reject" } },
        class: "rounded-md bg-gray-200 px-4 py-2 font-medium text-gray-800 hover:bg-gray-300 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600" %>
  <%= link_to "Back to queue", pending_decisions_path(kind: kind_filter), class: "ml-auto self-center text-sm text-gray-500 hover:underline dark:text-gray-400" %>
</div>
