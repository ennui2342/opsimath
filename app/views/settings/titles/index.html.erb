<% content_for :title, "Titles to review" %>

<div class="w-full max-w-3xl">
  <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Titles to review</h1>
  <p class="mb-4 mt-1 text-sm text-gray-600 dark:text-gray-400">
    Books whose title isn't ISFDB's main title — the title of first publication. Take ISFDB's (yours stays findable as an
    alternate title), keep yours, or — when ISFDB's is another book altogether — choose the right printing to fix its link.
  </p>

  <% if @fixes.empty? %>
    <p class="rounded-lg border border-dashed border-gray-300 p-8 text-center text-sm text-gray-500 dark:border-gray-600 dark:text-gray-400">Nothing to review.</p>
  <% else %>
    <ul class="divide-y divide-gray-200 rounded-lg border border-gray-200 dark:divide-gray-700 dark:border-gray-700">
      <% @fixes.each do |fix| %>
        <% edition = fix.work.editions_in_order.first %>
        <li class="px-4 py-3 text-sm">
          <p><%= work_link(fix.work, classes: "font-medium text-gray-900 dark:text-gray-100") %></p>
          <p class="text-gray-600 dark:text-gray-400">ISFDB: <span class="text-gray-900 dark:text-gray-100"><%= fix.to %></span>
            <span class="text-xs">· <%= { variant: "known by your title too", reworded: "worded differently", suspect: "nothing in common — probably the wrong ISFDB record" }.fetch(fix.kind, fix.kind.to_s.humanize) %></span></p>
          <div class="mt-2 flex flex-wrap items-center gap-2">
            <%= button_to "Use ISFDB's", settings_title_path(fix.work), method: :patch, params: { choice: "isfdb" }, class: card_button_class %>
            <%= button_to "Keep mine", settings_title_path(fix.work), method: :patch, params: { choice: "mine" }, class: card_button_class %>
            <% if edition %>
              <%= link_to "Wrong book? Choose the right printing", edit_work_edition_change_path(fix.work, edition), class: "text-xs text-gray-500 hover:underline dark:text-gray-400" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
