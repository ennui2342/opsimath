<% content_for :title, "Add a book" %>
<% secondary = "rounded-md bg-gray-200 px-3 py-1.5 text-sm font-medium text-gray-800 hover:bg-gray-300 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600" %>
<% primary = "rounded-md bg-green-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-green-700 dark:bg-green-700 dark:hover:bg-green-600" %>
<% provider_labels = Ui::EditionChoiceCardComponent::PROVIDER_LABELS %>

<div class="w-full max-w-3xl">
  <h1 class="mb-4 text-2xl font-bold">Add a book</h1>

  <%= form_with url: add_book_path, method: :get, class: "mb-6 flex gap-2", data: { controller: "barcode-scan",
                 barcode_scan_scripts_value: [ asset_path("zxing_reader.js"), asset_path("scan.js") ].to_json,
                 barcode_scan_wasm_url_value: asset_path("zxing_reader.wasm"), barcode_scan_secure_url_value: "#{Rails.application.config.x.public_url}#{add_book_path(scan: 1)}",
                barcode_scan_autostart_value: params[:scan].present? } do %>
    <input type="search" name="q" value="<%= @query %>" placeholder="Title and author, or an ISBN" autofocus
           aria-label="Title and author, or an ISBN" data-barcode-scan-target="input"
           class="min-w-0 flex-1 rounded-md border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-green-600 dark:border-gray-700 dark:bg-gray-900">
    <button type="button" hidden data-barcode-scan-target="button" data-action="barcode-scan#open" class="<%= secondary %>">Scan barcode</button>
    <button type="submit" class="<%= primary %>">Search</button>

    <%# The camera, full screen while scanning (the PWA's scanner overlay). %>
    <div hidden data-barcode-scan-target="overlay" class="fixed inset-0 z-50 bg-black">
      <video data-barcode-scan-target="video" playsinline muted class="h-full w-full object-cover"></video>
      <div class="pointer-events-none absolute left-1/2 top-1/2 aspect-[5/3] w-[70%] max-w-80 -translate-x-1/2 -translate-y-1/2 rounded-lg border-2 border-white/80"></div>
      <p data-barcode-scan-target="hint" class="absolute inset-x-0 bottom-12 px-6 text-center text-white"></p>
      <button type="button" data-action="barcode-scan#close" aria-label="Close scanner"
              class="absolute right-4 top-4 rounded-full bg-black/60 px-3 py-1 text-xl text-white">✕</button>
    </div>
  <% end %>

  <% if @query.match?(/\A\d{12}\z/) %>
    <p class="mb-3 text-sm text-gray-700 dark:text-gray-300">
      That's a US retail UPC — it names the publisher and price, not the book. Add the five digits printed
      over the small barcode beside it (e.g. <span class="font-mono"><%= @query %> 30054</span>) and search again.
    </p>
  <% elsif (upc = UpcLookup.parse(@query)) && @results.empty? %>
    <p class="text-sm text-gray-500 dark:text-gray-400">
      No printing has <span class="font-mono"><%= upc.last %></span> in the middle of its ISBN. Check it against the five digits
      printed over the small barcode beside the UPC — a scan can misread them — and search again with the right ones.
    </p>
  <% elsif @query.present? && @results.empty? %>
    <p class="text-sm text-gray-500 dark:text-gray-400">Nothing found in ISFDB or Open Library for “<%= @query %>”. Try fewer words, or the author's surname with a title word.</p>
  <% end %>

  <ul class="divide-y divide-gray-200 rounded-lg border border-gray-200 dark:divide-gray-800 dark:border-gray-800 <%= "hidden" if @results.empty? %>">
    <% @results.each do |result| %>
      <% token = sign(result.to_payload) %>
      <li class="flex gap-3 px-4 py-3">
        <div class="h-20 w-14 flex-none bg-gray-50 dark:bg-gray-900">
          <% if result.cover_url %><%= image_tag result.cover_url, alt: "", loading: "lazy", class: "h-full w-full object-contain" %><% end %>
        </div>
        <div class="min-w-0 flex-1 text-sm">
          <p class="font-medium"><%= result.title %></p>
          <p class="text-gray-600 dark:text-gray-400"><%= result.authors.join(", ") %><%= " · #{result.first_year}" if result.first_year %></p>
          <p class="text-xs text-gray-400 dark:text-gray-500">
            <%= result.providers.map { |p| provider_labels.fetch(p, p) }.join(" + ") %><%= " · #{pluralize(result.edition_count, 'edition')}" if result.edition_count.positive? %>
          </p>
          <div class="mt-2 flex flex-wrap items-center gap-2">
            <% if result.work %>
              <% wanted_only = result.work.want && result.work.editions.empty? %>
              <%= render Ui::BadgeComponent.new(text: wanted_only ? "On your wishlist" : "In your catalogue", variant: wanted_only ? :default : :success) %>
              <%= link_to "Open", work_path(result.work), class: "text-sm text-green-700 hover:underline dark:text-green-400" %>
              <%= link_to wanted_only ? "I've got it" : "Add an edition", add_book_editions_path(work_id: result.work.id), class: secondary %>
            <% else %>
              <%= link_to "Choose edition", add_book_editions_path(found: token), class: primary %>
              <%= button_to "Want it", add_book_path, params: { found: token, intent: "want" }, class: secondary %>
            <% end %>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
</div>
