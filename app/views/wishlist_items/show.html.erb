<% content_for :title, @view.want.title %>
<% gbp = ->(pence) { pence ? format("%.2f", pence / 100.0) : "" } %>
<% rule_labels = { a_format: "A-format", b_format: "B-format", no_paperback: "Any physical copy", unknown_printings: "Any copy (no ISFDB printings)", buy_new: "Buy new", override: "Your choice" } %>

<div class="w-full max-w-5xl">
  <div class="mb-4 flex flex-wrap gap-2">
    <%= render Ui::BadgeComponent.new(text: rule_labels.fetch(@view.rule.rule, @view.rule.rule.to_s.humanize),
                                      variant: @view.hunted? ? :info : :default) %>
    <% if @view.overridden? %><%= render Ui::BadgeComponent.new(text: "Covers chosen", variant: :accent) %><% end %>
  </div>
  <h1 class="text-2xl font-bold"><%= @view.want.title %></h1>
  <p class="mb-4 text-sm text-gray-500 dark:text-gray-400">
    <%= @view.want.author_name %><%= " (d. #{@view.want.author.died_date.first(4)})" if @view.want.author&.died_date %>
  </p>

  <% toggle = "text-sm text-green-700 hover:underline dark:text-green-400" %>
  <p class="mb-3 text-sm text-gray-500 dark:text-gray-400">
    <% if @view.all_formats %>
      Every physical printing's cover, your settings aside.
      <%= link_to "Show just your collecting rule's covers", wishlist_item_path(@view.want), class: toggle %>
    <% else %>
      The covers your collecting rule offers.
      <%= link_to "Show all formats", wishlist_item_path(@view.want, all: 1), class: toggle %>
    <% end %>
  </p>

  <%= form_with url: wishlist_item_path(@view.want), method: :patch, class: "mb-8" do %>
    <% if @view.all_formats %><input type="hidden" name="all" value="1"><% end %>
    <% if @view.covers.any? %>
      <p class="mb-3 text-sm text-gray-600 dark:text-gray-400">Tick the covers you want.</p>
      <div class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        <% @view.covers.each do |cover| %>
          <%= render Ui::CoverChoiceCardComponent.new(cover:) %>
        <% end %>
      </div>
    <% elsif @view.hunted? %>
      <p class="mb-6 text-sm text-gray-600 dark:text-gray-400">ISFDB has no printings for this book yet — a book just wanted is looked up within a minute, so try reloading; otherwise every listing below is a copy of unknown printing.</p>
    <% else %>
      <p class="mb-6 text-sm text-gray-600 dark:text-gray-400"><%= CollectingProfile.current.buy_new_for_living_authors ? "Recent, or the author is alive," : "Recent," %> and never in A-format — buy it new. Not searched on eBay.</p>
    <% end %>

    <div class="mb-6 flex flex-wrap items-end gap-4">
      <label class="text-sm">
        <span class="mb-1 block text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Target price (£, delivered)</span>
        <input type="text" name="target_price" inputmode="decimal" value="<%= gbp.(@view.want.target_price) %>" placeholder="none"
               class="w-28 rounded-md border border-gray-300 px-2 py-1.5 focus:ring-2 focus:ring-green-600 dark:border-gray-700 dark:bg-gray-900">
      </label>
      <label class="text-sm">
        <span class="mb-1 block text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Hunt on eBay</span>
        <select name="buy_new" class="rounded-md border border-gray-300 px-2 py-1.5 focus:ring-2 focus:ring-green-600 dark:border-gray-700 dark:bg-gray-900">
          <% current = { nil => "rule", false => "hunt", true => "buy_new" }[@view.want.buy_new_override] %>
          <% { "rule" => "As the rule says", "hunt" => "Always hunt", "buy_new" => "Buy new instead" }.each do |value, label| %>
            <option value="<%= value %>" <%= "selected" if current == value %>><%= label %></option>
          <% end %>
        </select>
      </label>
      <button type="submit" class="rounded-md bg-green-600 px-4 py-2 font-medium text-white hover:bg-green-700 dark:bg-green-700 dark:hover:bg-green-600">Save</button>
    </div>
  <% end %>

  <% others = @view.other_listings %>
  <% { other_printing: "Other printings and formats", unknown: "Printing unknown", pending: "Not identified yet" }.each do |key, heading| %>
    <% next unless others[key]&.any? %>
    <h2 class="mb-2 text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= heading %> (<%= others[key].size %>)</h2>
    <ul class="mb-6 divide-y divide-gray-200 rounded-lg border border-gray-200 dark:divide-gray-800 dark:border-gray-800">
      <% others[key].each do |listing| %>
        <li>
          <%= link_to listing.link, target: "_blank", rel: "noopener", class: "flex items-center gap-3 px-3 py-2 hover:bg-gray-50 dark:hover:bg-gray-800" do %>
            <% if listing.image_url %><%= image_tag listing.image_url, alt: "", loading: "lazy", class: "h-14 w-10 flex-none object-cover" %><% end %>
            <span class="min-w-0 flex-1 truncate text-sm"><%= listing.title %></span>
            <span class="flex-none text-sm font-medium">£<%= gbp.(listing.total) %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= link_to "Back to wishlist", wishlist_items_path, class: "text-sm text-gray-500 hover:underline dark:text-gray-400" %>
</div>
