<% content_for :title, @author.name %>
<% isfdb = @author.external_ids["isfdb"] %>
<% entries = @bibliography.entries %>

<div class="w-full max-w-3xl">
  <p class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Author</p>
  <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100"><%= @author.name %></h1>
  <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
    <%= [ ("died #{@author.died_date}" if @author.died_date.present?),
          pluralize(entries.size, "book"),
          "#{entries.count { |e| e.status == :owned }} owned",
          "#{entries.count { |e| e.work&.statuses&.include?(:read) }} read" ].compact.join(" · ") %>
    <% if isfdb %>· <%= link_to "ISFDB", "https://www.isfdb.org/cgi-bin/ea.cgi?#{ERB::Util.url_encode(isfdb)}", target: "_blank", rel: "noopener", class: "hover:underline" %><% end %>
  </p>
  <% unless @bibliography.fetched? %>
    <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Showing the books in your catalogue — their full ISFDB bibliography is being fetched; reload in a minute.</p>
  <% end %>

  <% row = ->(e) { render "shared/catalogue_entry", entry: e, number: e.year,
                           detail: (e.series && [ e.series, ("##{format('%g', e.series_num)}" if e.series_num.to_f.positive?) ].compact.join(" ")),
                           want_url: want_title_author_path(@author), want_params: { title_id: e.title_id },
                           add_query: [ e.title, @author.name ].join(" ") } %>
  <% list = "divide-y divide-gray-200 rounded-lg border border-gray-200 dark:divide-gray-700 dark:border-gray-700" %>

  <% if @bibliography.owned.any? %>
    <h2 class="mb-2 mt-6 text-sm font-semibold uppercase text-gray-500 dark:text-gray-400">Your books</h2>
    <ul class="<%= list %>"><% @bibliography.owned.each { |e| %><%= row.(e) %><% } %></ul>
  <% end %>

  <% @bibliography.by_kind.each do |type, group| %>
    <h2 class="mb-2 mt-6 text-sm font-semibold uppercase text-gray-500 dark:text-gray-400"><%= AuthorBibliography::KINDS.fetch(type) %></h2>
    <ul class="<%= list %>"><% group.each { |e| %><%= row.(e) %><% } %></ul>
  <% end %>

  <% @other_roles.each do |role, works| %>
    <h2 class="mb-2 mt-6 text-sm font-semibold uppercase text-gray-500 dark:text-gray-400">As <%= role.humanize(capitalize: false) %></h2>
    <%= render "works/book_list", works:, note: ->(w) { w.original_publication_year } %>
  <% end %>

  <%= link_to "Back to books", works_path, class: "mt-8 inline-block text-sm text-gray-500 hover:underline dark:text-gray-400" %>
</div>
