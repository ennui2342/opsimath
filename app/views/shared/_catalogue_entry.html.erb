<%# One book on an author or series page (AuthorBibliography / SeriesVolumes
    entries): a number or year, the title (linked when it's in the
    catalogue) with a detail line, its statuses — and for one Mark doesn't
    have, "Want it" / "Add". Title wraps; the actions drop under it on a
    phone. `want_url` / `want_params`: the Want it form; `extra`: optional
    trailing content (the series page's "Not this one"). %>
<% badges = ApplicationHelper::WORK_STATUS_BADGES %>
<% small = "rounded bg-gray-200 px-2 py-0.5 text-xs font-medium text-gray-800 hover:bg-gray-300 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600" %>
<li class="flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
  <span class="flex min-w-0 items-baseline gap-3 <%= "opacity-60" if entry.status == :missing %>">
    <span class="w-10 flex-none text-right text-xs tabular-nums text-gray-400 dark:text-gray-500"><%= number %></span>
    <span class="min-w-0">
      <% if entry.work %>
        <%= link_to entry.title, work_path(entry.work), class: "block font-medium text-gray-900 hover:underline dark:text-gray-100" %>
      <% else %>
        <span class="block font-medium text-gray-900 dark:text-gray-100"><%= entry.title %></span>
      <% end %>
      <% if detail.present? %><span class="block text-xs text-gray-500 dark:text-gray-400"><%= detail %></span><% end %>
    </span>
  </span>
  <span class="flex flex-none flex-wrap items-center gap-1 pl-[3.25rem] sm:justify-end sm:pl-0">
    <% entry.work&.statuses&.each do |s| %><%= render Ui::BadgeComponent.new(text: badges[s].first, variant: badges[s].last) %><% end %>
    <% if %i[missing catalogued].include?(entry.status) && entry.title_id && !local_assigns[:excluded] %>
      <%= button_to "Want it", want_url, params: want_params, class: small %>
      <%= link_to "Add", add_book_path(q: add_query), class: small %>
    <% end %>
    <%= local_assigns[:extra] %>
  </span>
</li>
