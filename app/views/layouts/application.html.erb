<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) ? "#{content_for(:title)} — opsimath" : "opsimath" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="App">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
    <% if authenticated? %>
      <header class="border-b border-gray-200 dark:border-gray-800">
        <nav class="container mx-auto flex flex-wrap items-center gap-x-6 gap-y-2 px-5 py-3">
          <%= link_to "opsimath", root_path, class: "font-bold" %>
          <%= link_to "Books", works_path, class: "text-sm text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100" %>
          <% pd = PendingDecision.pending.count %>
          <%= link_to "Pending decisions#{" (#{pd})" if pd.positive?}", pending_decisions_path, class: "text-sm text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100" %>
          <% er = EditionReconciliation.pending.count %>
          <%= link_to "Edition reconciliations#{" (#{er})" if er.positive?}", edition_reconciliations_path, class: "text-sm text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100" %>
          <%= button_to "Log out", session_path, method: :delete, class: "ml-auto text-sm text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100" %>
        </nav>
      </header>
    <% end %>

    <main class="container mx-auto flex px-5 py-8">
      <%= yield %>
    </main>
  </body>
</html>
